# BrizCore Backend Environment Variables

# App
APP_NAME=BrizCore
APP_ENV=development
DEBUG=True

# Database
DATABASE_URL=postgresql://brizcore_user:brizcore_pass@localhost:5432/brizcore_db

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
